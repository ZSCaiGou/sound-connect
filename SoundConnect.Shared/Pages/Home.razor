@page "/"
@using SoundConnect.Shared.Services
@inject IAudioEngine Engine
@implements IDisposable

<PageTitle>共享音乐</PageTitle>

<div class="app-head">
    <div class="app-title">
        <h1>共享音乐</h1>
        <span>把你正在听的歌，连同你的声音，一起送进语音软件</span>
    </div>
    <div class="head-actions">
        <span class="status-pill @(snapshot.IsRunning ? "live" : "")">
            <span class="dot"></span>@StatusText
        </span>
        @if (snapshot.IsRunning)
        {
            <button class="btn btn-outline-danger" @onclick="OnStop">停止共享</button>
        }
        else
        {
            <button class="btn btn-primary" @onclick="OnStart" disabled="@busy">
                @(busy ? "正在建立…" : "开始共享")
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert">@message</div>
}

@if (loading)
{
    <div class="chips" style="margin-bottom:16px">
        <span class="chip">正在读取设备与程序…</span>
    </div>
}

<div class="card">
    <div class="card-body">
        <h2>来源与输出</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">音乐来源</label>
                <select class="form-select" @bind="musicProcessId">
                    <option value="0">（不共享音乐）</option>
                    @foreach (var item in processes)
                    {
                        <option value="@item.ProcessId">
                            @item.Name@(item.State == "正在发声" ? "（正在发声）" : "")
                        </option>
                    }
                </select>
                <div class="form-text">只抓这个程序的声音，其他程序一概不受影响。</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">你的麦克风</label>
                <select class="form-select" @bind="microphoneId">
                    <option value="">（只共享音乐）</option>
                    @foreach (var device in Engine.CaptureDevices)
                    {
                        <option value="@device.Id">@device.Name</option>
                    }
                </select>
                <div class="form-text">选你真实的麦克风，别选虚拟设备。</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">送到哪条线</label>
                <select class="form-select" @bind="outputId">
                    @foreach (var device in Engine.RenderDevices)
                    {
                        <option value="@device.Id">@(device.IsVirtual ? "◆ " : "")@device.Name</option>
                    }
                </select>
                <div class="form-text">语音软件的输入设备要选同一条线的录音端。</div>
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-outline-secondary btn-sm" @onclick="OnRefresh">刷新设备与程序</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2>电平</h2>
        @foreach (var meter in Meters)
        {
            <div class="meter">
                <span class="meter-label">@meter.Label</span>
                <div class="meter-track">
                    <div class="meter-fill @(meter.Value > 0.5 ? "hot" : "")"
                         style="width:@Percent(meter.Value)%"></div>
                </div>
                <span class="meter-value">@ToDb(meter.Value)</span>
            </div>
        }

        @if (snapshot.IsClipping)
        {
            <div class="alert mt-3 mb-0">音量过大、已经削顶了，把音乐或麦克风音量往下调一点。</div>
        }

        <hr style="border-color:var(--line);opacity:0.6;margin:18px 0" />

        <div class="gain-row">
            <span class="hint-inline">音乐音量</span>
            <input type="range" class="form-range" min="-20" max="20" step="1"
                   value="@musicGainDb" @onchange="OnMusicGainChanged" />
            <span class="gain-value">@musicGainDb.ToString("F0") dB</span>
        </div>
        <div class="gain-row">
            <span class="hint-inline">麦克风音量</span>
            <input type="range" class="form-range" min="-20" max="40" step="1"
                   value="@microphoneGainDb" @onchange="OnMicrophoneGainChanged" />
            <span class="gain-value">@microphoneGainDb.ToString("F0") dB</span>
        </div>

        <label class="hint-inline d-flex align-items-center gap-2 mt-3">
            <input type="checkbox" checked="@Engine.AutoGainEnabled" @onchange="OnAutoGainChanged" />
            麦克风自动增益（现在自动加了 @snapshot.AutoGainDb.ToString("F1") dB，轻声说话也能被听清）
        </label>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2>对方听到的效果<span class="sub">从线里实测，不是估算</span></h2>
        <div class="chips">
            <span class="chip @(snapshot.IsClipping ? "bad" : "ok")">
                削顶 @(snapshot.IsClipping ? "有" : "无")
            </span>
            <span class="chip">响度 @ToDb(snapshot.SentLevel)</span>
            <span class="chip">峰值 @ToDb(snapshot.SentPeak)</span>
            <span class="chip @(snapshot.MusicUnderruns + snapshot.MicrophoneUnderruns == 0 ? "ok" : "bad")">
                断续 @(snapshot.MusicUnderruns + snapshot.MicrophoneUnderruns) 次/秒
            </span>
        </div>
        @if (snapshot.IsRunning && snapshot.MusicLevel < 0.001)
        {
            <div class="form-text">
                选中的程序现在没有声音。确认它正在播放，或者点上面的「刷新设备与程序」重新选一个。
            </div>
        }
        <div class="form-text">
            削顶为"无"、断续为 0 就是干净的；峰值贴着 0dB 时把音量往下调一点。
        </div>
    </div>
</div>

<details>
    <summary>音效（暂时用不上可以不管）</summary>
    <div class="details-body">
        <div class="form-text mb-2">
            把音频文件丢进 <code>@snapshot.EffectFolder</code>，点下面的「扫描音效」，文件名就是音效名。
        </div>
        <div class="effect-grid mb-3">
            @foreach (var effect in snapshot.Effects)
            {
                <button class="btn btn-outline-primary btn-sm" disabled="@(!Engine.IsRunning)"
                        @onclick="() => Engine.TriggerEffect(effect.Name)">
                    ▶ @effect.Name
                </button>
            }
            @if (snapshot.Effects.Count == 0)
            {
                <span class="form-text">还没扫描过音效。</span>
            }
        </div>
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary btn-sm" @onclick="OnScanEffects">扫描音效</button>
            <span class="hint-inline">音效音量 @effectsGainDb.ToString("F0") dB</span>
            <input type="range" class="form-range" style="max-width:200px" min="-20" max="20" step="1"
                   value="@effectsGainDb" @onchange="OnEffectsGainChanged" />
            <button class="btn btn-outline-danger btn-sm" @onclick="OnStopEffects">全部停止</button>
        </div>
    </div>
</details>

<details>
    <summary>诊断日志</summary>
    <div class="details-body">
        <pre class="log">@string.Join(Environment.NewLine, snapshot.Log)</pre>
    </div>
</details>

@code {
    private sealed record MeterRow(string Label, double Value);

    private AudioEngineSnapshot snapshot = new();
    private IReadOnlyList<AudioProcessInfo> processes = [];
    private int musicProcessId;
    private string microphoneId = string.Empty;
    private string outputId = string.Empty;
    private double musicGainDb;
    private double microphoneGainDb;
    private double effectsGainDb = -1;
    private bool busy;
    private bool loading = true;
    private string message = string.Empty;

    private MeterRow[] Meters =>
    [
        new("音乐", snapshot.MusicLevel),
        new("麦克风", snapshot.MicrophoneLevel),
        new("送出去", snapshot.OutputLevel)
    ];

    /// <summary>状态胶囊上顺带显示已经共享了多久。</summary>
    private string StatusText
    {
        get
        {
            if (!snapshot.IsRunning) return "未开启";
            var elapsed = TimeSpan.FromSeconds(snapshot.ElapsedSeconds);
            return elapsed.TotalHours >= 1
                ? $"正在共享 · {elapsed:hh\\:mm\\:ss}"
                : $"正在共享 · {elapsed:mm\\:ss}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Engine.Changed += OnEngineChanged;
        await RefreshAsync();
        await Engine.ScanEffectsAsync(null);
    }

    public void Dispose()
    {
        Engine.Changed -= OnEngineChanged;
    }

    private void OnEngineChanged()
    {
        _ = InvokeAsync(() =>
        {
            snapshot = Engine.Snapshot;
            musicGainDb = ToGainDb(snapshot.MusicGain);
            microphoneGainDb = ToGainDb(snapshot.MicrophoneGain);
            effectsGainDb = ToGainDb(snapshot.EffectsGain);
            StateHasChanged();
        });
    }

    private async Task RefreshAsync()
    {
        loading = true;
        StateHasChanged();
        try
        {
            await Engine.RefreshDevicesAsync();
            processes = await Engine.ListAudioProcessesAsync();
        }
        finally
        {
            loading = false;
        }

        outputId = PickOutputDevice();
        if (string.IsNullOrEmpty(microphoneId))
        {
            microphoneId = Engine.CaptureDevices.FirstOrDefault(device => !device.IsVirtual)?.Id
                ?? string.Empty;
        }
        if (musicProcessId == 0)
        {
            musicProcessId = processes.FirstOrDefault(item => item.State == "正在发声")?.ProcessId ?? 0;
        }

        snapshot = Engine.Snapshot;
        StateHasChanged();
    }

    /// <summary>优先选 VB-CABLE（实测单位增益、48k 立体声），其次是实测过的 Steam 那条。</summary>
    private string PickOutputDevice()
    {
        if (Engine.RenderDevices.Any(device => device.Id == outputId))
        {
            return outputId;
        }
        var verified = Engine.RenderDevices.FirstOrDefault(device =>
            device.Name.Contains("CABLE Input", StringComparison.OrdinalIgnoreCase)
        );
        verified ??= Engine.RenderDevices.FirstOrDefault(device =>
            device.Name.Contains("Steam Streaming Microphone", StringComparison.OrdinalIgnoreCase)
        );
        return verified?.Id
            ?? Engine.RenderDevices.FirstOrDefault(device => device.IsVirtual)?.Id
            ?? string.Empty;
    }

    private async Task OnRefresh()
    {
        busy = true;
        message = string.Empty;
        try
        {
            await RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnStart()
    {
        busy = true;
        message = string.Empty;
        try
        {
            await Engine.StartAsync(
                new AudioStartOptions(musicProcessId, microphoneId, outputId, string.Empty)
            );
        }
        catch (Exception error)
        {
            message = $"开始共享失败：{error.Message}";
        }
        finally
        {
            busy = false;
            snapshot = Engine.Snapshot;
        }
    }

    private async Task OnStop()
    {
        await Engine.StopAsync();
        snapshot = Engine.Snapshot;
    }

    private void OnMusicGainChanged(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var decibels))
        {
            musicGainDb = decibels;
            Engine.SetGain("music", Math.Pow(10, decibels / 20));
        }
    }

    private void OnMicrophoneGainChanged(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var decibels))
        {
            microphoneGainDb = decibels;
            Engine.SetGain("mic", Math.Pow(10, decibels / 20));
        }
    }

    private void OnEffectsGainChanged(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var decibels))
        {
            effectsGainDb = decibels;
            Engine.SetGain("effect", Math.Pow(10, decibels / 20));
        }
    }

    private void OnAutoGainChanged(ChangeEventArgs args)
    {
        Engine.AutoGainEnabled = args.Value is true;
    }

    private async Task OnScanEffects()
    {
        await Engine.ScanEffectsAsync(null);
        snapshot = Engine.Snapshot;
    }

    private void OnStopEffects()
    {
        Engine.StopEffects();
    }

    private static double ToGainDb(double linear)
    {
        return linear <= 0.0001 ? -20 : Math.Clamp(20 * Math.Log10(linear), -20, 40);
    }

    /// <summary>电平条按 dB 画：-60dB 是空，0dB 是满，这样看起来才有意义。</summary>
    private static int Percent(double value)
    {
        if (value <= 0.000001) return 0;
        var decibels = 20 * Math.Log10(value);
        return (int)Math.Clamp((decibels + 60) / 60 * 100, 0, 100);
    }

    private static string ToDb(double value)
    {
        return value <= 0.00001 ? "-∞ dB" : $"{20 * Math.Log10(value):F0} dB";
    }
}
